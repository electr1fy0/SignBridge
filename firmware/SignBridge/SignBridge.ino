// LCD formatting and haptic codes shared with the unified firmware.
const LCD_COLS = 16;
const LCD_ROWS = 2;

/** Upper-case and strip characters a HD44780 / PCF8574 LCD can't show reliably. */
function lcdSanitize(text) {
  return String(text)
    .replace(/[\u2018\u2019]/g, "'")
    .toUpperCase()
    .replace(/[^A-Z0-9 .,!?'-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

/**
 * Word-wrap to 2 x 16. Longer text is truncated with ".." on line 2;
 * the website always keeps the full message.
 * @param {string} text
 * @param {string[]} [override] hand-written [line1, line2] for known replies
 * @returns {{lines:[string,string], truncated:boolean}}
 */
function formatLcd(text, override) {
  if (override) {
    const [a = '', b = ''] = override.map((l) => lcdSanitize(l).slice(0, LCD_COLS));
    return { lines: [a, b], truncated: false };
  }
  const lines = [];
  let cur = '';
  for (let word of lcdSanitize(text).split(' ').filter(Boolean)) {
    while (word.length > LCD_COLS) {
      if (cur) { lines.push(cur); cur = ''; }
      lines.push(word.slice(0, LCD_COLS));
      word = word.slice(LCD_COLS);
    }
    if (!word) continue;
    if (!cur) cur = word;
    else if (cur.length + 1 + word.length <= LCD_COLS) cur += ' ' + word;
    else { lines.push(cur); cur = word; }
  }
  if (cur) lines.push(cur);

  if (lines.length <= LCD_ROWS) return { lines: [lines[0] ?? '', lines[1] ?? ''], truncated: false };
  const rest = lines.slice(1).join(' ');
  return { lines: [lines[0], rest.slice(0, LCD_COLS - 2).trimEnd() + '..'], truncated: true };
}

/** Suggested motor patterns, in ms: [on, off, on, …]. Implemented by the unified firmware. */
const VIBES = {
  ACK: { label: 'Short pulse', meaning: 'Acknowledgment / simple confirmation', pattern: [150] },
  YES: { label: 'Two short pulses', meaning: 'Yes', pattern: [150, 150, 150] },
  NO: { label: 'One long pulse', meaning: 'No', pattern: [800] },
  MSG: { label: 'Three short pulses', meaning: 'Incoming message / attention', pattern: [150, 150, 150, 150, 150] },
  URGENT: { label: 'Long-short repeated ×3', meaning: 'Urgent assistance', pattern: [500, 120, 150, 120, 500, 120, 150, 120, 500, 120, 150] },
};

function vibFor(text) {
  const t = String(text).trim().toLowerCase();
  if (/\b(help|doctor|emergency|urgent|ambulance)\b/.test(t)) return 'URGENT';
  if (/^(yes|yeah|yep)\b/.test(t)) return 'YES';
  if (/^(no|nope)\b(?!\s+problem)/.test(t)) return 'NO';
  if (/^(okay|ok|got it|sure|done)\b/.test(t)) return 'ACK';
  return 'MSG';
}

/** Unique-enough id that also works outside secure contexts (crypto.randomUUID doesn't on LAN http). */
function makeUid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}


// Web Speech API (Text-to-Speech) manager.
// Handles English voice selection, queue management, mute/unmute, replay, and user-activation unlocks.

class TextToSpeechManager {
  #synth = null;
  #voice = null;
  #muted = false;
  #lastSpokenText = '';
  #onStateChange = null;
  #onError = null;
  #unlocked = false;

  constructor({ onStateChange, onError } = {}) {
    this.#onStateChange = onStateChange || (() => {});
    this.#onError = onError || (() => {});
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      this.#synth = window.speechSynthesis;
      this.#muted = localStorage.getItem('signbridge_muted') === 'true';
      this.#loadVoices();
      if (this.#synth.onvoiceschanged !== undefined) {
        this.#synth.onvoiceschanged = () => this.#loadVoices();
      }
    }
  }

  isSupported() {
    return Boolean(this.#synth);
  }

  isMuted() {
    return this.#muted;
  }

  isUnlocked() {
    return this.#unlocked;
  }

  getLastSpokenText() {
    return this.#lastSpokenText;
  }

  #loadVoices() {
    if (!this.#synth) return;
    const voices = this.#synth.getVoices();
    if (!voices || voices.length === 0) return;

    // Preference: English natural voices, en-US / en-GB
    const englishVoices = voices.filter((v) => v.lang.startsWith('en'));
    // The glove's access point has no internet. Prefer installed voices over
    // network voices even when a remote voice sounds more natural.
    const localVoices = englishVoices.filter((v) => v.localService);
    const candidates = localVoices.length ? localVoices : englishVoices;
    const preferred = candidates.find((v) =>
      /natural|google|samantha|karen|daniel|moira/i.test(v.name)
    ) || candidates[0] || voices[0];

    this.#voice = preferred;
    this.#notifyState();
  }

  #notifyState() {
    this.#onStateChange({
      supported: this.isSupported(),
      muted: this.#muted,
      voiceName: this.#voice ? this.#voice.name : 'Default',
      lastText: this.#lastSpokenText,
      unlocked: this.#unlocked,
    });
  }

  toggleMute() {
    this.#muted = !this.#muted;
    localStorage.setItem('signbridge_muted', String(this.#muted));
    if (this.#muted && this.#synth) {
      this.#synth.cancel();
    }
    this.#notifyState();
    return this.#muted;
  }

  /**
   * Unlock speech synthesis on browsers that require user gesture activation.
   * Plays a silent utterance or brief confirmation.
   */
  unlock() {
    if (!this.#synth) return;
    this.#unlocked = true;
    try {
      const u = new SpeechSynthesisUtterance(' ');
      u.volume = 0.01;
      this.#synth.speak(u);
    } catch (e) {
      console.warn('[TTS] Unlock attempt:', e);
    }
    this.#notifyState();
  }

  /**
   * Speak a phrase aloud immediately. Cancels any stale pending speech to prevent backlog.
   * If speech fails or is muted, returns false without throwing so UI translation is never delayed.
   */
  speak(text) {
    if (!text || typeof text !== 'string') return false;
    this.#lastSpokenText = text;
    this.#notifyState();

    if (!this.#synth || this.#muted) return false;

    try {
      // Clear backlog so new signs are heard without stale delay
      this.#synth.cancel();

      const utterance = new SpeechSynthesisUtterance(text);
      if (this.#voice) {
        utterance.voice = this.#voice;
      }
      utterance.lang = 'en-US';
      utterance.rate = 0.95; // Slightly measured rate for clear assistive audio
      utterance.pitch = 1.0;
      utterance.volume = 1.0;

      utterance.onerror = (err) => {
        // SpeechSynthesis interrupted or cancelled is expected when new signs arrive
        if (err.error !== 'interrupted' && err.error !== 'canceled') {
          console.warn('[TTS] Speech error:', err);
          this.#onError('Voice could not play. Check audio or install an offline English voice on this device.');
        }
      };

      this.#synth.speak(utterance);
      this.#unlocked = true;
      this.#notifyState();
      return true;
    } catch (err) {
      console.warn('[TTS] Speak failed:', err);
      return false;
    }
  }

  /** Replay the last spoken text */
  replay() {
    if (this.#lastSpokenText) {
      this.speak(this.#lastSpokenText);
    }
  }
}


// State validation and replay handling shared by the live UI and tests.
function validateState(state) {
  if (!state || state.type !== 'state' || typeof state.boot !== 'string' || !Number.isFinite(state.uptime)) throw new Error('This address is not running SignBridge firmware.');
  for (const [key, length] of [['flex', 5], ['delta', 5], ['baseline', 5], ['acc', 3], ['gyro', 3]]) {
    if (!Array.isArray(state[key]) || state[key].length !== length) throw new Error(`Incomplete device data: ${key}`);
  }
  if (typeof state.env !== 'string') throw new Error('Incomplete device data: env');
  if (!Array.isArray(state.events)) throw new Error('Missing device event history.');
  return state;
}

function consumeEvents(cursor, state) {
  const changedBoot = cursor.boot !== state.boot;
  const previous = changedBoot ? 0 : cursor.seq;
  const events = state.events.filter((event) => Number.isInteger(event.seq) && event.seq > previous && ['sign', 'reply'].includes(event.type)).sort((a, b) => a.seq - b.seq);
  // Initial history and restart history are shown, but never spoken again.
  const audible = changedBoot ? [] : events.filter((event) => event.type === 'sign');
  return { cursor: { boot: state.boot, seq: Math.max(previous, ...events.map((event) => event.seq)) }, events, audible };
}

function replyDelivery(event) {
  return event.lcd ? `Written to glove LCD${event.haptic ? '; vibration triggered' : ''}` : 'Received by glove; LCD unavailable';
}


