/** Flat list for search: [{text, sign?, replies, scenario}] */
function allPhrases() {
  return [
    ...GENERIC.map((p) => ({ ...p, scenario: 'Everyday' })),
    ...SCENARIOS.flatMap((s) => s.phrases.map((p) => ({ ...p, scenario: s.name }))),
  ];
}

function findPhrase(text) {
  const t = String(text).trim().toLowerCase();
  return allPhrases().find((p) => p.text.toLowerCase() === t) ?? null;
}


// LCD formatting and haptic codes shared with the unified firmware.
const LCD_COLS = 16;
const LCD_ROWS = 2;

/** Upper-case and strip characters a HD44780 / PCF8574 LCD can't show reliably. */
function lcdSanitize(text) {
