const DEFAULT_REPLIES = ['Yes', 'No', 'Give me a minute', 'Please repeat that.'];

function environment(id) {
  return ENVIRONMENTS.find((env) => env.id === id) ?? ENVIRONMENTS[0];
}

/** "thumbs_up", " Fist " → "FIST". Changes formatting only, never meaning. */
function normalizeGesture(raw) {
  return String(raw).trim().toUpperCase().replace(/[_\s]+/g, ' ');
}

/** @returns {{key:string, gesture:string, text:string, env:string, known:boolean, urgent:boolean, replies:Array}} */
function meaning(rawGesture, envId) {
  const key = normalizeGesture(rawGesture);
  const env = environment(envId);
  const gesture = GESTURES[key];
  const phrase = env.phrases[key];
  if (!gesture || !phrase) return { key, gesture: key, text: key, env: env.name, known: false, urgent: false, replies: DEFAULT_REPLIES };
  return { key, gesture: gesture.name, text: phrase.text, env: env.name, known: true, urgent: Boolean(gesture.urgent), replies: phrase.replies };
}

/** Normalise a reply entry to {text, lcd?}. */
function replyItem(entry) {
  return typeof entry === 'string' ? { text: entry } : entry;
}


